PORT=3000
JWT_SECRET=rahasia_super_aman_perusahaan_2026_ganti_di_produksi
JWT_EXPIRES_IN=8h

# ========================================================
# Konfigurasi Supabase PostgreSQL
# Dapatkan dari: Supabase Dashboard > Project Settings > Database
# ========================================================

# OPSI A (Rekomendasi): Menggunakan Connection String Pooler / Direct URL
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# OPSI B: Menggunakan Parameter Individual
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_NAME=postgres

# (Opsional) Supabase JS SDK Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# CORS
CORS_ORIGIN=
