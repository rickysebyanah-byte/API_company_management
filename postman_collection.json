    {
      "name": "2. HRD - Penerimaan Karyawan Baru (Onboarding)",
      "item": [
        {
          "name": "2.1 [TOMBOL HRD] Terima Karyawan Baru (Buat Akun & Profil Sekaligus)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{hrd_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"karyawan_budi_{{$randomInt}}\",\n  \"email\": \"budi_{{$randomInt}}@company.com\",\n  \"password\": \"password123\",\n  \"role\": \"Karyawan\",\n  \"employee_code\": \"EMP-{{$randomInt}}\",\n  \"full_name\": \"Budi Hartono S.Kom\",\n  \"position_id\": 5,\n  \"manager_code\": \"EMP-004\",\n  \"hire_date\": \"2026-03-01\",\n  \"phone\": \"08123456789\"\n}"
            },
            "url": "{{base_url}}/api/hr/employees/onboard",
            "description": "HRD menerima karyawan baru. Begitu request ini sukses (201 Created), token dan kode unik karyawan baru OTOMATIS disimpan ke Postman environment. Anda bisa langsung membuka folder 3 (Ajukan Cuti) dan request cuti akan otomatis atas nama karyawan baru ini!"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data) {",
                  "        if (json.data.token) {",
                  "            pm.collectionVariables.set('karyawan_token', json.data.token);",
                  "            pm.collectionVariables.set('karyawan_baru_token', json.data.token);",
                  "            pm.environment.set('karyawan_token', json.data.token);",
                  "            pm.environment.set('karyawan_baru_token', json.data.token);",
                  "        }",
                  "        if (json.data.employee_code) {",
                  "            pm.collectionVariables.set('employee_code', json.data.employee_code);",
                  "            pm.collectionVariables.set('karyawan_baru_code', json.data.employee_code);",
                  "            pm.environment.set('employee_code', json.data.employee_code);",
                  "            pm.environment.set('karyawan_baru_code', json.data.employee_code);",
                  "        }",
                  "        if (json.data.full_name) {",
                  "            pm.collectionVariables.set('employee_name', json.data.full_name);",
                  "            pm.collectionVariables.set('karyawan_baru_nama', json.data.full_name);",
                  "            pm.environment.set('employee_name', json.data.full_name);",
                  "            pm.environment.set('karyawan_baru_nama', json.data.full_name);",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2.2 Lihat Semua Karyawan Lengkap",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hrd_token}}"
              }
            ],
            "url": "{{base_url}}/api/hr/employees",
            "description": "Melihat daftar seluruh karyawan perusahaan beserta jabatannya."
          }
        },
        {
          "name": "2.3 Lihat Detail Karyawan (Berdasarkan Kode Unik EMP-005)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hrd_token}}"
              }
            ],
            "url": "{{base_url}}/api/hr/employees/EMP-005",
            "description": "Melihat detail lengkap karyawan cukup menggunakan kode unik karyawan (contoh: EMP-005). Tidak perlu mengingat ID angka database lagi."
          }
        },
        {
          "name": "2.4 Ubah Data Karyawan (Berdasarkan Kode Unik EMP-005)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{hrd_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Rina Kartika S.Kom (Lead)\",\n  \"phone\": \"08119999955\"\n}"
            },
            "url": "{{base_url}}/api/hr/employees/EMP-005",
            "description": "Mengubah data karyawan berdasarkan kode unik 'EMP-005'."
          }
        },
        {
          "name": "2.5 Nonaktifkan / Hapus Karyawan (Kode Unik EMP-099)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hrd_token}}"
              }
            ],
            "url": "{{base_url}}/api/hr/employees/EMP-099",
            "description": "Menghapus karyawan dummy percobaan menggunakan kode unik 'EMP-099'."
          }
        }
      ]
    },
    {
      "name": "3. Pengajuan & Persetujuan Cuti (Alur Lengkap)",
      "item": [
        {
          "name": "3.1 [Karyawan] Ajukan Permohonan Cuti Baru",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{karyawan_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employee_code\": \"{{employee_code}}\",\n  \"full_name\": \"{{employee_name}}\",\n  \"leave_type\": \"Cuti Tahunan\",\n  \"start_date\": \"2026-05-10\",\n  \"end_date\": \"2026-05-12\",\n  \"reason\": \"Liburan keluarga dan istirahat\"\n}"
            },
            "url": "{{base_url}}/api/leaves/apply",
            "description": "Mengajukan permohonan cuti untuk karyawan baru (menggunakan token & kode unik '{{employee_code}}'). Cuti otomatis terhubung dengan atasan (Manager Budi Santoso) dan berstatus 'Pending'. ID cuti otomatis tersimpan ke variabel {{leave_id}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.id) {",
                  "        pm.collectionVariables.set('leave_id', json.data.id);",
                  "        pm.environment.set('leave_id', json.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3.2 [Karyawan] Lihat Riwayat Pengajuan Cuti Saya",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{karyawan_token}}"
              }
            ],
            "url": "{{base_url}}/api/leaves/my",
            "description": "Karyawan melihat status seluruh pengajuan cutinya (Pending, Approved, atau Rejected)."
          }
        },
        {
          "name": "3.3 [Karyawan] Batalkan Pengajuan Cuti Saya (Jika Masih Pending)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{karyawan_token}}"
              }
            ],
            "url": "{{base_url}}/api/leaves/my/3",
            "description": "Membatalkan permohonan cuti pending. Otomatis aman jika permohonan sudah dibatalkan sebelumnya."
          }
        },
        {
          "name": "3.4 [HRD & Admin] Lihat Semua Permohonan Cuti Seluruh Karyawan",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hrd_token}}"
              }
            ],
            "url": "{{base_url}}/api/leaves?status=Pending",
            "description": "HRD atau Admin melihat daftar permohonan cuti yang perlu ditinjau (filter: ?status=Pending)."
          }
        },
        {
          "name": "3.5 [HRD & Manager] SETUJUI (Approve) Permohonan Cuti Karyawan Baru",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{hrd_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Approved\",\n  \"review_notes\": \"Permohonan cuti karyawan baru telah disetujui. Selamat berlibur!\"\n}"
            },
            "url": "{{base_url}}/api/leaves/{{leave_id}}/review",
            "description": "HRD / Atasan menyetujui (Approve) cuti karyawan baru. Menggunakan token HRD ({{hrd_token}}) yang otomatis tersimpan saat login HRD."
          }
        },
        {
          "name": "3.6 [HRD & Manager] TOLAK (Reject) Permohonan Cuti",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{hrd_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Rejected\",\n  \"review_notes\": \"Mohon reschedule karena bertepatan dengan deadline proyek.\"\n}"
            },
            "url": "{{base_url}}/api/leaves/{{leave_id}}/review",
            "description": "HRD atau Manager menolak cuti karyawan disertai catatan alasan penolakan."
          }
        }
      ]
    },
    {
      "name": "4. Karyawan - Presensi / Absensi Harian & Profil Diri",
      "item": [
        {
          "name": "4.1 Presensi Masuk (Check-In Harian)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{karyawan_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Hadir WFO kantor pusat tepat waktu\"\n}"
            },
            "url": "{{base_url}}/api/me/attendances/check-in",
            "description": "Karyawan melakukan absensi masuk harian."
          }
        },
        {
          "name": "4.2 Presensi Pulang (Check-Out Harian)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{karyawan_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Selesai menyelesaikan tugas harian\"\n}"
            },
            "url": "{{base_url}}/api/me/attendances/check-out",
            "description": "Karyawan melakukan absensi pulang harian."
          }
        },
        {
          "name": "4.3 Lihat Riwayat Absensi Saya",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{karyawan_token}}"
              }
            ],
            "url": "{{base_url}}/api/me/attendances?page=1&limit=10",
            "description": "Karyawan melihat daftar riwayat kehadirannya sendiri."
          }
        },
        {
          "name": "4.4 Lihat Profil Saya Sendiri",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{karyawan_token}}"
              }
            ],
            "url": "{{base_url}}/api/me/profile",
            "description": "Melihat informasi identitas, jabatan, departemen, dan nama atasan langsung."
          }
        },
        {
          "name": "4.5 Ubah Profil Saya Sendiri (Nama / Telepon)",
          "request": {
            "method": "PUT",
            "header": [
