  "item": [
    {
      "name": "1. Login Akun (Pilih Akun & Token Otomatis Tersimpan)",
      "item": [
        {
          "name": "1.1 Login sebagai HRD (siti_hrd)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.token) {",
                  "        pm.collectionVariables.set('hrd_token', json.data.token);",
                  "        pm.collectionVariables.set('token', json.data.token);",
                  "        pm.environment.set('hrd_token', json.data.token);",
                  "        pm.environment.set('token', json.data.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"siti_hrd\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/api/auth/login",
            "description": "Gunakan request ini untuk login sebagai HRD. Hak akses: Menerima karyawan baru, mengelola absensi, departemen, jabatan, dan menyetujui cuti."
          }
        },
